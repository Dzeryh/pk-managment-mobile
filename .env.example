# Copier ce fichier en `.env` (non versionné) pour changer la cible de l'API.
#
#   Émulateur Android          http://10.0.2.2:3000/api
#   Téléphone physique (LAN)   http://192.168.1.20:3000/api
#   Simulateur iOS             http://localhost:3000/api
#
# Par défaut (aucun .env) : http://10.0.2.2:3000/api
# Redémarrer `npx expo start` après modification : la valeur est lue au démarrage.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
